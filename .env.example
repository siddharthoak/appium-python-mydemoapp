# Copy to .env (gitignored) and fill in for whichever provider you're using.
# Select the active provider here — everything else is provider-specific and
# only read when that provider is selected.
MOBILE_TEST_PROVIDER=local
# local | saucelabs | browserstack

# ---- provider=local (Android Studio emulator, or a real device over USB) ----
# The Appium server you started yourself (`appium`) — reachable at localhost
# if pytest runs on the same machine as the emulator/device, or
# host.docker.internal if pytest runs inside this project's own container
# and the emulator/Appium server run on the host Mac instead.
APPIUM_SERVER_URL=http://localhost:4723
ANDROID_DEVICE_NAME=emulator-5554
# Only needed the very first run, to install the APK onto the device/emulator
# — after that, appPackage/appActivity (already set below, no need to touch)
# relaunch the already-installed app without reinstalling every time.
ANDROID_APP_PATH=./apps/my-demo-app-android.apk

# ---- provider=saucelabs (Sauce Labs real device cloud) ----
# Upload the APK to Sauce Storage first (see README), then reference it here
# by the filename you uploaded it as.
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1
SAUCE_APP_STORAGE_FILE=storage:filename=my-demo-app-android.apk
SAUCE_DEVICE_NAME=Google Pixel .*
SAUCE_PLATFORM_VERSION=13

# ---- provider=browserstack (BrowserStack App Automate) ----
# Upload the APK via BrowserStack's app upload REST API first (see README),
# then reference it here by the app_url/bs:// id that upload call returns.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_ID=
BROWSERSTACK_DEVICE_NAME=Google Pixel 8
BROWSERSTACK_OS_VERSION=14.0
